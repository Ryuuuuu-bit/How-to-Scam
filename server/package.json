{
  "name": "@hts/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "prisma generate",
    "typecheck": "prisma generate && node ../scripts/typecheck.mjs --noEmit",
    "test": "vitest run",
    "migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@hts/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.5",
    "google-auth-library": "11.3.4",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "pg": "^8.23.1",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1"
  }
}
