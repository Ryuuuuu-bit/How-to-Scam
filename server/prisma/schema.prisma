// ฐานข้อมูลของ How to Scam
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserKind {
  guest
  google
}

enum RunStatus {
  started
  submitted
  rejected
}

/// ผู้เล่น 1 คน = 1 UID ไม่ว่าจะเป็น Guest หรือ Google (Guest ผูก Google ทีหลังได้ UID เดิม)
model User {
  id          String   @id @default(uuid())
  kind        UserKind @default(guest)
  googleSub   String?  @unique
  email       String?
  displayName String
  avatarUrl   String?
  /// แต้มประสบการณ์แก๊ง (ใช้ปลดล็อกอาชีพ)
  xp          Int      @default(0)
  runsPlayed  Int      @default(0)
  /// เคยเล่น Daily Challenge กี่ครั้ง
  dailyPlays  Int      @default(0)
  /// ฉากจบที่เคยเห็น (ใช้ปลดล็อกตัวลับ)
  endings     String[] @default([])
  /// เงินใต้ดิน: ได้จากทุกรอบที่จบ ใช้ซื้อตัวละครและของแต่ง
  money       Int      @default(0)
  /// ของที่ซื้อหรือได้จากออดิชั่นแล้ว เช่น "char:live_seller"
  owned       String[] @default([])
  /// สมุดภาพการ์ดเหยื่อ { [cardId]: VictimCard } (ของสะสม ไม่มีผลกับเกม)
  scrapbook   Json     @default("{}")
  /// ประวัติข้ามรอบสำหรับยศในซอย (รอบที่เล่น รอดกี่รอบ หนีรอดกี่ครั้ง ฯลฯ)
  career      Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastOnlineAt DateTime?
  feedback     Feedback[]
  runs        Run[]
  scores      Score[]
  achievements UserAchievement[]
  @@index([lastOnlineAt])
}

/// เหรียญความสำเร็จที่ผู้เล่นได้แล้ว
model UserAchievement {
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  unlockedAt    DateTime @default(now())

  @@id([userId, achievementId])
}

/// ซีซั่นรายเดือน id = "2026-11"
model Season {
  id       String   @id
  startsAt DateTime
  endsAt   DateTime
  scores   Score[]
}

/// หนึ่งรอบการเล่น: server ออก seed ตอนเริ่ม และ replay action log ตอนส่ง
model Run {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  seed        String
  characterId String
  /// "normal" หรือ "daily"
  mode        String    @default("normal")
  /// วันที่ของ Daily Challenge (เฉพาะ mode daily) — 1 คน 1 รอบต่อวัน
  dailyDate   String?
  status      RunStatus @default(started)
  actionCount Int       @default(0)
  rejectReason String?
  createdAt   DateTime  @default(now())
  submittedAt DateTime?
  score       Score?

  @@unique([userId, dailyDate])
  @@index([userId, createdAt])
}

/// คะแนนที่ผ่านการตรวจแล้ว (1 ต่อรอบ)
model Score {
  id          String   @id @default(uuid())
  runId       String   @unique
  run         Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seasonId    String
  season      Season   @relation(fields: [seasonId], references: [id])
  characterId String
  score       Int
  cleanCash   Int
  days        Int
  reason      String
  endingId    String
  titleId     String
  mode        String   @default("normal")
  dailyDate   String?
  createdAt   DateTime @default(now())

  @@index([dailyDate, score])
  @@index([seasonId, score])
  @@index([seasonId, days])
  @@index([seasonId, reason, days])
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  message   String
  createdAt DateTime @default(now())
}
